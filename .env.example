# --- Required in production ---

# Public HTTPS URL of this control plane. Deployed instances phone home to it,
# so it MUST be reachable from the internet (and should be HTTPS since agent
# API keys transit this channel).
BASE_URL=https://deploy.example.com

# Secret for signing session cookies. Generate: openssl rand -hex 32
SESSION_SECRET=change-me

# AWS credentials with Lightsail permissions (or use the default AWS SDK
# credential chain: ~/.aws/credentials, instance profile, etc.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Optional ---

PORT=3000
DB_PATH=./agentdeploy.db

# Lightsail bundle for new instances. small_3_0 = 2GB RAM / $12/mo (1 agent).
BUNDLE_ID=small_3_0

# Prebuilt agent image to pull at instance bootstrap (built by the
# agent-image GitHub Action). Empty = build from source on each instance (slow).
AGENT_IMAGE=ghcr.io/ks0430/agentquarters-agent:latest

# Max instances per user (abuse guard)
MAX_INSTANCES_PER_USER=3

# Set to 1 to fake the cloud provider (no AWS calls, instant "instances")
# for local development.
MOCK_PROVIDER=

# --- Secrets at rest ---
# 64 hex chars: openssl rand -hex 32
# Encrypts customer secrets (agent env vars, API keys, chat platform tokens).
# KEEP A COPY: losing this key makes existing encrypted rows unreadable.
# Unset = plaintext storage (the app warns loudly at boot).
SECRETS_KEY=

# --- Database backups (off-site) ---
# Hourly gzipped snapshots of the control-plane DB to S3. Off unless set.
# Needs s3:PutObject, s3:ListBucket, s3:DeleteObject on the bucket.
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PREFIX=agentdeploy-db/
BACKUP_KEEP=48
BACKUP_INTERVAL_MIN=60
